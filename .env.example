# ウラスポの環境変数サンプル。値はすべて空欄。コピーして `.env.local`（ローカル）
# または Vercel の Environment Variables（本番/Preview）に設定してください。
# 手順の全体は docs/DEPLOY.md を参照。

# ---- 公開（ブラウザに露出する。NEXT_PUBLIC_* はビルド時にクライアントへ埋め込まれる） ----

# Supabase プロジェクトの URL（例: https://xxxxxxxx.supabase.co）。公開情報。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の anon key。公開鍵（RLSで保護される前提のため公開して良い）。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ログイン用メールのリンクの戻り先 origin。リクエストヘッダーは使わずこの値だけを使う。
# 本番（VERCEL_ENV=production または NODE_ENV=production）では https の URL のみ許可。
# 本番以外は https、または http の localhost/127.0.0.1/[::1] のみ許可。
# 例: https://urasupo.jp
NEXT_PUBLIC_SITE_URL=

# ---- 秘密（サーバー側のみ。Vercel では Production/Preview 各環境で個別に設定し、
#      「Sensitive」にチェックしてブラウザに出さないこと。絶対にコミットしない） ----

# Supabase の service_role key。cron（/api/cron/verification）と、お問い合わせの保存（/contact の
# Server Action。SPEC §9.17）だけが使う秘密鍵。
# 利用者本人のセッションでの操作（投稿・承認・確認）はこれを使わない。
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron からの呼び出しを認可する秘密の値。32文字以上のランダムな文字列にすること
# （`scripts/check-production-env.mjs` が32文字未満・空白混入・既定値そのまま・同じ文字の
# 繰り返し等の弱い値を失敗として検出する。公開前に
# `node --env-file=.env.production.local scripts/check-production-env.mjs` で確認する）。
# `Authorization: Bearer <CRON_SECRET>` が一致しない呼び出しは401で拒否される
# （CRON_SECRET が未設定・空の場合を含む）。
CRON_SECRET=

# お問い合わせ（/contact）の送信元ごとの回数制限に使うソルト（SPEC §9.17）。
# 送信元IPはそのまま保存せず、sha256(IP + この値) だけを DB に渡す。32文字以上のランダムな値にすること。
# 未設定だと、起動はするがお問い合わせの送信時に拒否される（デモモードでは不要）。
CONTACT_RATE_SALT=

# ---- お問い合わせの運営への通知（任意。docs/DEPLOY.md 4.6） ----
# RESEND_API_KEY と CONTACT_NOTIFY_TO の両方が設定されているときだけ、問い合わせを保存したあと
# Resend（https://resend.com）で運営へ短いメールを送る。本文は「用件・受付ID・受付時刻」だけで、
# 問い合わせの本文や返信先は載せない。どちらかが空なら通知しない（保存はされる）。

# Resend の API キー（秘密。Vercel では Secret 種別で登録する）。
RESEND_API_KEY=

# 通知の宛先（運営のメールアドレス。複数ならカンマ区切り）。
CONTACT_NOTIFY_TO=

# 通知の送信元（任意）。Resend で検証済みのドメインのアドレスを「表示名 <address>」の形で書く。
# 空なら "ウラスポ <onboarding@resend.dev>"（Resend の検証用。自分のアカウントのアドレスにしか届かない）。
CONTACT_NOTIFY_FROM=

# ---- 開発・テスト専用（本番では設定しない） ----

# デモモード（インメモリのフィクスチャ + 固定のデモユーザー）を明示的に有効にする。
# "1" のときだけデモモードになる。本番実行環境（VERCEL_ENV=production または
# NODE_ENV=production）で "1" が設定されていると起動時に例外になる。
# next build / next start は NODE_ENV=production で動くため、本番環境ではこの変数を
# 設定しないこと。
URASUPO_DEMO_MODE=

# next dev / next build の .next 出力先を切り替える（実DB版E2E専用。通常は不要）。
NEXT_DIST_DIR=
